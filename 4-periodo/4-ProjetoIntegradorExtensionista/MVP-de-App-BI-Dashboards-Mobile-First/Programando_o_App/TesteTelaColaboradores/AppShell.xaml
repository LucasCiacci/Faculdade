<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TesteTelaColaboradores.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TesteTelaColaboradores.Views"
    Title="TesteTelaColaboradores"
    
    Shell.NavBarHasShadow="False"
    Shell.BackgroundColor="#1E3A8A"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.BackButtonBehavior="{BackButtonBehavior IconOverride='arrow_back_white.png'}"
>

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

</Shell>
