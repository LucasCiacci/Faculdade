<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TesteTelaColaboradores.Views.MainPage"
    Title="Página Inicial">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label 
            Text="Bem-vindo ao App RH!"
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <Button 
            Text="Ir para Colaboradores"
            BackgroundColor="#1E3A8A"
            TextColor="White"
            Clicked="OnGoToColaboradoresClicked"
            CornerRadius="25"
            HeightRequest="50"/>
    </VerticalStackLayout>
</ContentPage>
